{
  "name": "@nivvi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build --workspace @nivvi/contracts && tsx watch --env-file=.env.local src/server.ts",
    "build": "npm run build --workspace @nivvi/contracts && tsc -p tsconfig.build.json",
    "start": "node --env-file=.env.local dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests prisma.config.ts",
    "test": "npm run build --workspace @nivvi/contracts && tsx --env-file=.env.test.local --test --test-concurrency=1 tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=.env.local ../../node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:test": "node --env-file=.env.test.local ../../node_modules/prisma/build/index.js migrate deploy",
    "mail:work": "tsx --env-file=.env.local src/mail-worker.ts"
  },
  "dependencies": {
    "@nivvi/contracts": "*",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "express": "5.3.0",
    "argon2": "0.45.2",
    "jose": "6.2.17",
    "zod": "4.6.7",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.4",
    "pino": "10.4.0",
    "nodemailer": "10.5.0",
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/luxon": "3.7.6",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.2",
    "@eslint/js": "10.0.1"
  }
}
