# Copy to .env.local and generate independent random secrets. Never commit credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://nivvi_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/nivvi_development
DIRECT_DATABASE_URL=postgresql://nivvi_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@127.0.0.1:55432/nivvi_development
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JOB_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
MAIL_MODE=file
MAIL_DIRECTORY=../../.local/backend/mail
MAIL_FROM=noreply@nivvi.local
# Future UI/deep-link target; the Phase 3 mobile app is not integrated yet.
PUBLIC_APP_URL=http://127.0.0.1:8081/
# Production only: use an authenticated TLS SMTP URL; no SMTP is contacted in local tests.
# SMTP_URL=smtps://username:password@smtp.example.com:465
